ClearAll[Phi]; 
f[x_] := 1/(1 + 25*x^2)
n = 2; 
I0 = Integrate[(f[x]*ChebyshevT[0, x])/Sqrt[1 - x^2], {x, -1, 1}]; 
a0 = I0/Pi; 
phi = a0*ChebyshevT[0, x]; 
Print["Για j = 0: p0(x) = ", ChebyshevT[0, x], " | a0 = ", a0]; 
Do[T = Integrate[(f[x]*ChebyshevT[j, x])/Sqrt[1 - x^2], {x, -1, 1}]; 
 aj = (2*T)/Pi; Print["Για j = ", j, ": p", j, "(x) = ", 
      ChebyshevT[j, x], " | a", j, " = ", aj]; 
 phi = phi + aj*ChebyshevT[j, x], {j, 1, n}]
Phi[x_] = phi; 
Print["Φ(x) = ", Expand[Phi[x]]]; 
Error = Sqrt[Integrate[(f[x] - Phi[x])^2/Sqrt[1 - x^2], {x, -1, 1}]]; 
Print["E = ", N[Error]]; 
Plot[{Phi[x]}, {x, -1, 1}, Frame -> True, Axes -> False, 
 PlotStyle -> {Red}]

