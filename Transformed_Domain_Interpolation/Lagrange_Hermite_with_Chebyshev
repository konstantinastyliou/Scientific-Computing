(*Lagrange with Chebyshev*)
f[x_] := 1/(1 + 25*x^2);
a = -1; b = 1; n = 20;
nodesX = Table[-Cos[(k*Pi)/(n)], {k, 0, n}];
nodesT = nodesX;
data = Table[{nodesT[[i]], f[nodesX[[i]]]}, {i, 1, n + 1}];
L[i_] := Function[tVal, 
   Product[If[i == j, 
     1, (tVal - nodesT[[j]])/(nodesT[[i]] - nodesT[[j]])], {j, 1, 
     n + 1}]];
p[t_] := Sum[data[[i, 2]]*L[i][t], {i, 1, n + 1}];
poly = Simplify[N[p[t]]];
Print["Το πολυώνυμο Lagrange"];
Print[poly];
Plot[Evaluate[{f[t], p[t]}], {t, -1, 1}, 
 PlotStyle -> {Directive[Blue, Thick], Directive[Red, Dashed, Thick]},
  Epilog -> {Black, PointSize[0.02], Point[data]}, 
 PlotLegends -> {"f(x)", "p(t) Lagrange (Chebyshev)"}, 
 AxesLabel -> {"t", "y"}, 
 PlotLabel -> "Παρεμβολή Lagrange με Chebyshev", 
 GridLines -> Automatic]

(*Hermite with Chebyshev*)
f[x_] := 1/(1 + 25*x^2);
df[x_] := f'[x];
a = -1; b = 1; n = 10;
t[x_] := 2 (x - a)/(b - a) - 1;
k = (b - a)/2;
nodesX = Table[-Cos[(k*Pi)/(n)], {k, 0, n}];
nodesT = nodesX;
yV = Table[f[nodesX[[i]]], {i, 1, n + 1}];
dyV = Table[df[nodesX[[i]]]*k, {i, 1, n + 1}];
L[i_] := Function[tt, 
   Product[If[j == i, 
     1, (tt - nodesT[[j]])/(nodesT[[i]] - nodesT[[j]])], {j, 1, 
     n + 1}]];
dL = Table[D[L[i][tt], tt] /. tt -> nodesT[[i]], {i, 1, n + 1}];

Hi[i_] := 
  Function[tt, (1 - 2 (tt - nodesT[[i]]) dL[[i]]) (L[i][tt])^2];
HiHat[i_] := Function[tt, (tt - nodesT[[i]]) (L[i][tt])^2];
pH[tt_] := 
  Sum[yV[[i]] Hi[i][tt] + dyV[[i]] HiHat[i][tt], {i, 1, n + 1}];
Print["Το πολυώνυμο Hermite "];
Print[Simplify[N[pH[t]]]];

Plot[Evaluate[{f[a + (t + 1)/2*(b - a)], pH[t], 
   df[a + (t + 1)/2*(b - a)]*k}], {t, -1, 1}, 
 PlotStyle -> {Directive[Blue, Thick], Directive[Red, Dashed, Thick], 
   Directive[Green, Thick]}, 
 Epilog -> {Black, PointSize[0.02], Point[Transpose[{nodesT, yV}]]}, 
 PlotLegends -> {"f(x)", "p(t) Hermite με Chebyshev", "df[x]"}, 
 AxesLabel -> {"t", "y"}, 
 PlotLabel -> "Παρεμβολή Hermite με Chebyshev", 
 GridLines -> Automatic, PlotRange -> All]
