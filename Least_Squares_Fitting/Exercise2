ClearAll[p];
AxData = {1.0, 1.3, 1.6, 1.9, 2.5, 3.1, 4.0, 6.0, 9.0};
xData = Table[i, {i, 1, 9}];
fData = {1.86, 1.97, 2.09, 2.22, 2.51, 2.83, 3.38, 5.05, 9.20};
FF[x_] := x + 2 x^2;
AfData = Table[FF[i], {i, 1, 9}]

Flinear = fData/xData
Linearpoints = Transpose[{xData, Flinear}];
TableForm[Linearpoints]

line = Fit[Linearpoints, {1, x}, x]

valA = Coefficient[line, x, 0];
valB = Coefficient[line, x, 1];
p[x_] := valA*x + valB*x^2;

removals = fData - Table[p[xi], {xi, xData}];
epsilon = Sqrt[Total[removals^2]];
diaspora = epsilon^2/(9 + 1 - 2);


Print["Βέλτιστη συνάρτηση p(x) = ", p[x]];
Print["(ε) = ", epsilon] // N;
Print["(σ^2) = ", diaspora] // N;

Show[ListPlot[Transpose[{xData, fData}], 
  PlotStyle -> {Red, PointSize[0.02]}, 
  PlotLabel -> "p(x) = ax + bx^2"], 
 Plot[p[x], {x, 1, 9}, PlotStyle -> Blue]]

Exit[]
